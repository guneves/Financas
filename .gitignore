# ==========================================
# BACKEND (Python / Flask)
# ==========================================
# Ambientes Virtuais
venv/
env/
.venv/

# Arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class
*.db
*.db-shm
*.db-wal
.jwt_secret
# Copia em disco do historico dos graficos (backend/history_store.py)
history_cache.json*
tesouro_precos.csv*
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
backend/backups/
# Comprovantes anexados aos lancamentos (dados pessoais, nunca no git)
backend/attachments/
# Log estruturado com rotacao (app.log, app.log.1...)
backend/logs/
# Bancos de teste temporarios e logs de servidor
tmp_*.db
*.log


# ==========================================
# FRONTEND (Node.js / React / Vite)
# ==========================================
# Dependências do Node
node_modules/
/frontend/node_modules/

# Pastas de build de produção do Vite
dist/
dist-ssr/
# Build do APK (mobile/build-apk.ps1), com a API apontada para o Tailscale
dist-android/
build/

# Logs de erro do NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# SEGURANÇA E VARIÁVEIS DE AMBIENTE
# ==========================================
# NUNCA suba segredos locais para o GitHub!
.env
.env.*
!.env.example

# ==========================================
# SISTEMA OPERACIONAL E IDE (VS Code)
# ==========================================
# Arquivos do Windows
Thumbs.db
Desktop.ini

# Arquivos do macOS (caso alguém da equipe use Mac)
.DS_Store

# Configurações locais do VS Code
.vscode/
.idea/

# Cache do pytest
.pytest_cache/

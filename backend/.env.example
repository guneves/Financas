DATABASE_PATH=finance.db
# Resolved against the PROJECT root (the repo dir), not backend/.
DATABASE_MIGRATIONS_DIR=database/migrations
DATABASE_BACKUP_DIR=backups
# Backup automatico no boot. Retencao remove apenas os arquivos gerados
# automaticamente (finance-AAAAMMDD-HHMMSS.*); backups com nome proprio ficam.
AUTO_BACKUP_ON_BOOT=1
AUTO_BACKUP_MIN_INTERVAL_HOURS=12
BACKUP_RETENTION_DAYS=7
# Comprovantes dos lancamentos (PDF/imagem). Fora do zip de backup; cada backup
# mantem um espelho em DATABASE_BACKUP_DIR/attachments. Leve a pasta junto ao mudar de maquina.
ATTACHMENTS_DIR=attachments
ATTACHMENT_MAX_BYTES=10485760
SQLITE_BUSY_TIMEOUT_MS=5000
JWT_SECRET=troque-esta-chave-em-producao
# Duracao do login, em dias, no PC e no celular (decisao de 2026-10-12: 180).
# O backend so e alcancado pelo Tailscale, e um login vencido no celular para
# o envio em segundo plano ate o app ser aberto de novo.
JWT_EXP_DAYS=180
# Origens que podem chamar a API de outro endereco. O Vite (5173) em
# desenvolvimento; `https://localhost` e o APK (Capacitor). O navegador do
# celular abre a tela pelo proprio Flask (mesma origem) e nao precisa entrar aqui.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
# O build do frontend que o Flask serve em `/` (`.\start.ps1 -Built`).
# Resolvido a partir da raiz do projeto.
FRONTEND_DIST_DIR=frontend/dist
FLASK_DEBUG=0
PRICE_CACHE_TTL_SECONDS=60
PRICE_FETCH_TIMEOUT_SECONDS=6
PRICE_DOWNLOAD_TIMEOUT_SECONDS=8
PRICE_FETCH_WORKERS=2
PRICE_QUOTE_STALE_HOURS=36

# brapi (https://brapi.dev) — provedor primario de cotacoes da B3 quando ha
# token; sem token o app usa apenas o yfinance. O token fica so no backend.
BRAPI_TOKEN=
BRAPI_CACHE_TTL_SECONDS=300
BRAPI_TIMEOUT_SECONDS=8

# Log estruturado (applog.py): uma linha JSON por evento no stderr e, com
# LOG_TO_FILE=1, em LOG_DIR/app.log (5 arquivos de 1 MB).
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=1

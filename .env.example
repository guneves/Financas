# Copy to .env on the server (cp .env.example .env) and fill in.
# Read by compose.yaml (env_file + APP_PORT); never committed.

# Host port the app is published on (container listens on 5000).
APP_PORT=

# A long random string. Generate with:  openssl rand -hex 32
# Changing it logs every device out. Left empty (or a known example value),
# the app generates one and keeps it next to the database (.jwt_secret).
JWT_SECRET=

# Signup is open only while the database has no user (the owner's first
# signup). Set 1 to let someone else create an account.
ALLOW_SIGNUP=0

# Login lifetime in days (PC and phone).
JWT_EXP_DAYS=180

# The APK's origin (Capacitor). The browser opens screen and API on one origin
# and does not need to be listed.
CORS_ORIGINS=https://localhost

# Optional: brapi token for B3 quotes; empty = yfinance only.
BRAPI_TOKEN=

BACKUP_RETENTION_DAYS=7
AUTO_BACKUP_MIN_INTERVAL_HOURS=12
LOG_LEVEL=INFO

# Paths (DATABASE_PATH, ATTACHMENTS_DIR, ...) are set in the Dockerfile to /data,
# the named volume. Don't override them here.

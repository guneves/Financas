<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- O "+ Novo" nativo (ui/newentry/), aberto pelo "+" da casca: um sheet do Compose por
             cima da pagina, com o teclado no Valor. -->
        <activity
            android:name=".ui.newentry.NewEntryActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.NativeSheet"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- O app: a casca nativa (ui/nav/NativeActivity), o login e um NavHost do Compose com
             todas as paginas. Abre pelo icone (o alias abaixo) e pelas notificacoes. -->
        <activity
            android:name=".ui.nav.NativeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize" />

        <!-- O icone do app. Mantem o nome do launcher da WebView (.MainActivity): instalado por
             cima, o atalho na tela inicial continua valendo. -->
        <activity-alias
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:targetActivity=".ui.nav.NativeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- O leitor de notificacoes dos bancos (notify/). O Android so o liga depois que o dono
             permite o acesso em Ajustes do Android; a tela leva ate la (Ajustes › Notificações). -->
        <service
            android:name=".notify.BankNotificationListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- O aviso de "entre de novo" quando o envio em segundo plano para num 401. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Abrir o instalador com o APK novo que o CI publica (update/ApkUpdater.java). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+: sem isto o app nao ve se os apps ouvidos estao instalados (Ajustes ›
         Notificações). A mesma lista de notify/NotifyRules.java. -->
    <queries>
        <package android:name="com.samsung.android.spay" />
        <package android:name="br.com.flashapp" />
    </queries>
</manifest>
